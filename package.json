{
  "name": "m365-copilot-adoption-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cf:export-data": "python3 scripts/export_cloudflare_data.py",
    "cf:prepare": "npm run cf:export-data && npm run build",
    "cf:check": "npm run cf:prepare && npx wrangler deploy --dry-run",
    "cf:deploy": "npm run cf:prepare && npx wrangler deploy",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.81.0"
  }
}

{
  "name": "m365-copilot-adoption-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cf:export-data": "python3 scripts/export_cloudflare_data.py",
    "cf:prepare": "npm run cf:export-data && npm run build",
    "cf:check": "npm run cf:prepare && npx wrangler deploy --dry-run",
    "cf:deploy": "npm run cf:prepare && npx wrangler deploy",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}
